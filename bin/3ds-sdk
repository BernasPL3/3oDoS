#!/bin/bash

DEVKITPRO=/opt/devkitpro
DEVKITARM=$DEVKITPRO/devkitARM

ARMGCC=$DEVKITARM/bin/arm-none-eabi-gcc

case "$1" in

build)

    mkdir -p build

    CFILES=$(find source -name "*.c")

    echo "Compilando..."

    $ARMGCC $CFILES \
    -o build/game.elf \
    -Iinclude \
    -I$DEVKITPRO/libctru/include \
    -L$DEVKITPRO/libctru/lib \
    -lctru \
    -march=armv6k \
    -mtune=mpcore \
    -mfloat-abi=hard \
    -mtp=soft \
    -DARM11 \
    -D_3DS

    echo "Gerando icon.smdh..."

    smdhtool --create \
    "3oDoS" \
    "3oDoS Engine" \
    "BernasPL3" \
    assets/icon.png \
    icon.smdh

    echo "Gerando 3DSX..."

    3dsxtool \
    build/game.elf \
    build/game.3dsx \
    --smdh=icon.smdh

    echo "Build concluído!"
    ;;

cia)

    echo "Gerando CIA..."

    picasso \
    -o build/game.cia \
    build/game.elf

    echo "CIA gerado!"
    ;;

clean)

    rm -rf build

    echo "Build removido."
    ;;

run)

    echo "Copie build/game.3dsx para o SD do 3DS."
    ;;

*)

    echo "Uso:"
    echo "  3ds-sdk build"
    echo "  3ds-sdk cia"
    echo "  3ds-sdk run"
    echo "  3ds-sdk clean"
    ;;

esac
